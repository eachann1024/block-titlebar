{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-titlebar",
  "name": {
    "zh": "顶栏图标",
    "en": "Titlebar Icons"
  },
  "version": "1.0.1",
  "beta": true,
  "author": "eachann1024",
  "repo": "eachann1024/block-titlebar",
  "summary": {
    "zh": "自定义顶栏右上角显示的图标，隐藏不需要的按钮",
    "en": "Choose which icons appear in the top-right titlebar"
  },
  "entry": {
    "command": [
      "python3",
      "-u",
      "main.py"
    ]
  },
  "permissions": [
    "storage",
    "ui:titlebar"
  ],
  "permission_reasons": {
    "storage": {
      "zh": "保存已隐藏的顶栏图标列表配置",
      "en": "Save the list of hidden titlebar icons"
    },
    "ui:titlebar": {
      "zh": "读取顶栏图标项并控制各个按钮的显示与隐藏",
      "en": "Read titlebar items and control visibility of individual buttons"
    }
  },
  "surfaces": [
    "settings_page"
  ],
  "icon": {
    "view_box": "0 0 24 24",
    "fill_paths": [
      "M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4H4V6Z"
    ],
    "stroke_paths": [
      "M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z",
      "M4 10h16",
      "M7.5 14h6",
      "M7.5 17h4"
    ],
    "accent_paths": [
      "M11 7m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0",
      "M14 7m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0",
      "M17 7m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"
    ]
  }
}
